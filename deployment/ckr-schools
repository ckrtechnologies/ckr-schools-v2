# ==============================================================================
# CKR Technologies — Complete Production Nginx Configuration
# Multi-Tenant School Operating System (ckrschools.online)
#
# IMPORTANT — subdirectory hosting contract
# ------------------------------------------------------------------------------
# Every single-page app below is served from a sub-path. For that to work the
# app MUST be built with a matching Vite `base`:
#
#   URL path      Build                                Directory
#   /             npm run build                        marketplace/
#   /spoc/        VITE_BASE_PATH=/spoc/ npm run build  spoc/
#   /superadmin/  VITE_BASE_PATH=/superadmin/ npm run build  superadmin/
#   /admin/       VITE_BASE_PATH=/admin/ npm run build  admin/
#   tenant root/  npm run build                        tenant-admin/
#   /prototype/   (static prototype build)             prototype/
#
# `deployment/build.sh` produces exactly this layout.
#
# Nginx rules that make the sub-paths safe (do not remove):
#   1. `^~` on /api/, /cdn/, /uploads/ and every SPA prefix. Without it the
#      static-file regex at the bottom of the block wins and serves school
#      logos / gallery photos from the marketplace root, so every /cdn/*.jpg
#      returns 404.
#   2. `try_files $uri $uri/ /spoc/index.html;` — the LAST argument is the
#      fallback. Writing `... /spoc/index.html =404;` makes /spoc/index.html
#      just another file to test, so every deep link (/spoc/gallery,
#      /admin/leads, ...) returns 404.
#   3. `alias` + `try_files` is safe here because the fallback is a URI and
#      `=404` is never the final argument.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP -> HTTPS Global Redirect (Port 80)
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ckrschools.online www.ckrschools.online *.ckrschools.online;

    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------------------
# 2. Main Platform Domain: ckrschools.online & www.ckrschools.online
# Path Isolation Architecture:
# - /              -> Website Marketplace Portal
# - /superadmin/   -> Platform Super Admin Console
# - /spoc/         -> School SPOC Public-Domain Portal
# - /admin/        -> School Admin Operations Portal
# - /prototype/    -> Clickable Prototype Workbench
# - /api/          -> Express 5 API
# - /cdn/          -> Static CDN Assets
# - /uploads/      -> School Media & Photos
# ------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ckrschools.online www.ckrschools.online hq.ckrschools.online;

    ssl_certificate /etc/letsencrypt/live/ckrschools.online-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ckrschools.online-0001/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Default document root = marketplace SPA (served at "/")
    root /var/www/ckrschools/marketplace;
    index index.html;

    client_max_body_size 50M;
    client_body_timeout 300s;
    send_timeout 300s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # --------------------------------------------------------------------------
    # Surface 1: Express 5 API Reverse Proxy (/api/)
    # --------------------------------------------------------------------------
    location = /api {
        return 308 /api/;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:5006;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Stream large gallery videos instead of buffering them to disk
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 90s;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # --------------------------------------------------------------------------
    # Surface 1b: Socket.io Realtime Engine (/socket.io/)
    # --------------------------------------------------------------------------
    location ^~ /socket.io/ {
        proxy_pass http://127.0.0.1:5006;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 90s;
        proxy_cache_bypass $http_upgrade;
    }

    # --------------------------------------------------------------------------
    # Surface 2: Super Admin HQ Console (/superadmin/ and /super-admin/)
    # --------------------------------------------------------------------------
    location = /superadmin {
        return 301 /superadmin/;
    }
    location = /super-admin {
        return 301 /superadmin/;
    }
    location ^~ /super-admin/ {
        rewrite ^/super-admin/(.*)$ /superadmin/$1 permanent;
    }
    location ^~ /superadmin/ {
        alias /var/www/ckrschools/super-admin/;
        index index.html;
        try_files $uri $uri/ /superadmin/index.html;
    }

    # --------------------------------------------------------------------------
    # Surface 3: School SPOC Public-Domain Portal (/spoc/)
    # --------------------------------------------------------------------------
    location = /spoc {
        return 301 /spoc/;
    }
    location ^~ /spoc/ {
        alias /var/www/ckrschools/spoc/;
        index index.html;
        try_files $uri $uri/ /spoc/index.html;
    }

    # --------------------------------------------------------------------------
    # Surface 4: School Admin Operations Portal (/admin/)
    # --------------------------------------------------------------------------
    location = /admin {
        return 301 /admin/;
    }
    location ^~ /admin/ {
        alias /var/www/ckrschools/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # --------------------------------------------------------------------------
    # Surface 5: Clickable Prototype Workbench (/prototype/)
    # --------------------------------------------------------------------------
    location = /prototype {
        return 301 /prototype/;
    }
    location ^~ /prototype/ {
        alias /var/www/ckrschools/prototype/;
        index index.html;
        try_files $uri $uri/ /prototype/index.html;
    }

    # --------------------------------------------------------------------------
    # Surface 6: Public Uploads & Media Storage (/cdn/ & /uploads/)
    # (Points directly to project uploads directory instead of /srv)
    # --------------------------------------------------------------------------
    location ^~ /cdn/ {
        alias /var/www/ckrschools/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location ^~ /uploads/ {
        alias /var/www/ckrschools/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # --------------------------------------------------------------------------
    # Surface 7: Public Website Marketplace (Root /)
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}

# ------------------------------------------------------------------------------
# 3. Wildcard School Tenants: *.ckrschools.online (e.g. arc.ckrschools.online, vision.ckrschools.online)
# ------------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ~^(?<tenant_subdomain>[a-zA-Z0-9-]+)\.ckrschools\.online$;

    ssl_certificate /etc/letsencrypt/live/ckrschools.online-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ckrschools.online-0001/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Wildcard tenant admin portal (served at the subdomain root)
    root /var/www/ckrschools/tenant-admin;
    index index.html;
    client_max_body_size 50M;
    client_body_timeout 300s;
    send_timeout 300s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # API Proxy to Express Backend with Subdomain Forwarding
    location = /api {
        return 308 /api/;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:5006;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant_subdomain;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 90s;
        proxy_cache_bypass $http_upgrade;
    }

    # Socket.io Realtime Engine with Subdomain Forwarding
    location ^~ /socket.io/ {
        proxy_pass http://127.0.0.1:5006;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Tenant-Subdomain $tenant_subdomain;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 90s;
        proxy_cache_bypass $http_upgrade;
    }

    # --------------------------------------------------------------------------
    # Subdomain Surfaces: Dedicated Operational Desks on School Subdomain
    # Allows:
    # - <school>.ckrschools.online/spoc/             -> SPOC Marketing Portal
    # - <school>.ckrschools.online/admission/        -> Admissions Desk
    # - <school>.ckrschools.online/finance/          -> Finance & Fees Desk
    # - <school>.ckrschools.online/timetable/        -> Timetable & Proxies Desk
    # - <school>.ckrschools.online/teacher-manager/  -> Teacher Manager Desk
    # - <school>.ckrschools.online/tc/               -> Transfer Certificate Desk
    # - <school>.ckrschools.online/academic-manager/ -> Academic Exams Desk
    # --------------------------------------------------------------------------

    # 1. SPOC Public-Domain Portal (/spoc/)
    location = /spoc {
        return 301 /spoc/;
    }
    location ^~ /spoc/ {
        alias /var/www/ckrschools/spoc/;
        index index.html;
        try_files $uri $uri/ /spoc/index.html;
    }

    # 2. Admissions Desk (/admission/)
    location = /admission {
        return 301 /admission/;
    }
    location ^~ /admission/ {
        alias /var/www/ckrschools/admission/;
        index index.html;
        try_files $uri $uri/ /admission/index.html;
    }

    # 3. Finance & Fees Desk (/finance/)
    location = /finance {
        return 301 /finance/;
    }
    location ^~ /finance/ {
        alias /var/www/ckrschools/finance/;
        index index.html;
        try_files $uri $uri/ /finance/index.html;
    }

    # 4. Timetable Desk (/timetable/)
    location = /timetable {
        return 301 /timetable/;
    }
    location ^~ /timetable/ {
        alias /var/www/ckrschools/timetable/;
        index index.html;
        try_files $uri $uri/ /timetable/index.html;
    }

    # 5. Teacher Manager (/teacher-manager/ & /teacher_manager/)
    location = /teacher-manager {
        return 301 /teacher-manager/;
    }
    location = /teacher_manager {
        return 301 /teacher-manager/;
    }
    location ^~ /teacher_manager/ {
        rewrite ^/teacher_manager/(.*)$ /teacher-manager/$1 permanent;
    }
    location ^~ /teacher-manager/ {
        alias /var/www/ckrschools/teacher_manager/;
        index index.html;
        try_files $uri $uri/ /teacher-manager/index.html;
    }

    # 6. Transfer Certificate Desk (/tc/)
    location = /tc {
        return 301 /tc/;
    }
    location ^~ /tc/ {
        alias /var/www/ckrschools/tc/;
        index index.html;
        try_files $uri $uri/ /tc/index.html;
    }

    # 7. Academic Manager (/academic-manager/ & /academic_manager/)
    location = /academic-manager {
        return 301 /academic-manager/;
    }
    location = /academic_manager {
        return 301 /academic-manager/;
    }
    location ^~ /academic_manager/ {
        rewrite ^/academic_manager/(.*)$ /academic-manager/$1 permanent;
    }
    location ^~ /academic-manager/ {
        alias /var/www/ckrschools/academic_manager/;
        index index.html;
        try_files $uri $uri/ /academic-manager/index.html;
    }

    # Prototype accessible from school subdomain
    location = /prototype {
        return 301 /prototype/;
    }
    location ^~ /prototype/ {
        alias /var/www/ckrschools/prototype/;
        index index.html;
        try_files $uri $uri/ /prototype/index.html;
    }

    # Media & Uploads access
    location ^~ /cdn/ {
        alias /var/www/ckrschools/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location ^~ /uploads/ {
        alias /var/www/ckrschools/uploads/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # School Operations SPA Router
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets with caching
    location ~* \.(css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2|ttf)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, no-transform";
    }
}