# Local development only — copy to .env.development
VITE_API_URL=http://localhost:5006/api
VITE_MARKETPLACE_URL=http://localhost:5175

# Production: leave both unset. The build then uses same-origin /api and
# resolves the marketplace link from window.location.origin.
# Override only if the API or marketplace lives on another host:
# VITE_API_URL=https://ckrschools.online/api
# VITE_MARKETPLACE_URL=https://ckrschools.online
