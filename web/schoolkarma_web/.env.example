# ==============================================================================
# SchoolKarma Next.js Web App — Environment Variables Template
# ==============================================================================

# Internal Express 5 backend API URL for Server-Side Rendering (SSR) & rewrites
API_INTERNAL_URL=http://localhost:5006

# CDN Asset Proxy Destination (production server CDN)
CDN_PROXY_URL=https://schoolkarma.com

# Public Portal Canonical Base URL for SEO JSON-LD & OG tags
NEXT_PUBLIC_SITE_URL=https://schoolkarma.com

# Google Tag Manager (GTM) Container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

